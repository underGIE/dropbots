# Supabase project for TWO DJS (realtime broadcast only — no tables, no auth).
# Copy to .env.local and fill in. .env.local is gitignored.
# Project Settings -> API: "Project URL" and the "anon public" key.
# Never put the service_role key here: this file is shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
